# Database (MySQL)
DATABASE_URL="mysql://crm_user:crm_password@localhost:3306/real_estate_crm"

# API
API_PORT=4000
API_URL=http://localhost:4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Frontend
# Local: point at API. Single Heroku app: set both to empty (same origin).
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Heroku single dyno (API + Next together). Procfile sets SERVE_WEB=true.
# SERVE_WEB=true
# API_PORT is set from $PORT on Heroku.


# Vapi AI (keep secret — never commit real values)
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# Optional: OpenAI for post-call analysis fallback
OPENAI_API_KEY=

# Optional: n8n automation
# Production webhook URL from n8n (Workflow → Webhook node)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/real-estate-call-completed
N8N_SHARED_SECRET=change-me-n8n-secret

# Seed admin
SEED_ADMIN_EMAIL=admin@realestate.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Admin User
