{
  "name": "Call Completed → Slack/Follow-up",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "real-estate-call-completed",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-in",
      "name": "CRM Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300],
      "webhookId": "real-estate-call-completed"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.data.analysis.interestScore }}",
              "operation": "largerEqual",
              "value2": 50
            }
          ]
        }
      },
      "id": "if-interested",
      "name": "Interested?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:4000/api/outbound/n8n/trigger",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-secret",
              "value": "change-me-n8n-secret"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"action\": \"outbound_call\",\n  \"leadId\": \"{{ $json.data.leadId }}\"\n}",
        "options": {}
      },
      "id": "trigger-followup-call",
      "name": "Schedule Outbound Follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [760, 220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true } }}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1000, 300]
    }
  ],
  "connections": {
    "CRM Webhook": {
      "main": [[{ "node": "Interested?", "type": "main", "index": 0 }]]
    },
    "Interested?": {
      "main": [
        [{ "node": "Schedule Outbound Follow-up", "type": "main", "index": 0 }],
        [{ "node": "Respond", "type": "main", "index": 0 }]
      ]
    },
    "Schedule Outbound Follow-up": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
